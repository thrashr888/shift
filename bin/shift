#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export SHIFT_INSTALL_ROOT="$project_root"
# Classify options without mistaking their values for launch modes. The curses
# child re-enters this launcher with pipes; never wrap that backend in curses.
launch_tui=no
explicit_tui=no
backend_only=no
classify_launch() {
  if [ "${1-}" = "session-fork" ]; then
    backend_only=yes
    return
  fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tui) explicit_tui=yes ;;
      --print|-p|--mcp|--list-sessions|--fork-session|-h|--help)
        backend_only=yes
        return ;;
      --agent|--state-dir|--session|--new-session|--resume|--mode|--model|--allow-run|--set|--receipt|--mcp-port)
        if [ "$#" -lt 2 ]; then
          backend_only=yes
          return
        fi
        shift ;;
      --watch|--no-watch|--no-mcp) ;;
      -*) backend_only=yes; return ;;
    esac
    shift
  done
}
classify_launch "$@"
if [ "$backend_only" = no ] && [ -z "${SHIFT_CONTROL_FD-}" ] &&
   [ -z "${SHIFT_UI_EVENT_FD-}" ] && [ -z "${SHIFT_UI_COMMAND_FD-}" ]; then
  if [ "$explicit_tui" = yes ] || { [ -t 0 ] && [ -t 1 ]; }; then
    launch_tui=yes
  fi
fi
if [ "$launch_tui" = yes ]; then
  exec python3 "$project_root/scripts/tui.py" "$@"
fi
working_root=$(pwd -P)
export SHIFT_PROJECT_ROOT="$working_root"
# Compatibility for older extensions and trace bridge processes.
export LISP_AGENT_PROJECT_ROOT="$project_root"

state_root="$working_root/.shift"
if [ ! -e "$state_root" ] && [ -d "$working_root/.lisp-agent" ]; then
  state_root="$working_root/.lisp-agent"
fi

if [ "${1-}" = "session-fork" ]; then
  shift
  set -- --fork-session "$@"
fi

# Keep the compiled-module cache current so Guile never falls back to
# interpreting stale sources after a pull. Compile warnings still show.
if command -v make >/dev/null 2>&1; then
  make -s -C "$project_root" build >/dev/null \
    || echo "shift: build cache refresh failed; running from source" >&2
fi

exec guile \
  --no-auto-compile \
  -L "$project_root/src" \
  -L "$project_root/extensions" \
  -C "$project_root/build" \
  -c '(use-modules (live-agent main)) (main (cdr (command-line)))' \
  --agent "$project_root/agent/default.scm" \
  --state-dir "$state_root" \
  "$@"
